# Application  
DEBUG=False  
  
# SMTP Email Configuration  
SMTP_HOST=smtp.gmail.com  
SMTP_PORT=465  
SMTP_USER=your-email@gmail.com  
SMTP_PASS=your-app-password  
SMTP_USE_SSL=true  
SMTP_USE_TLS=false  
EMAIL_FROM=your-email@gmail.com  
  
# Admin receiver for ZIP results  
ADMIN_RESULTS_EMAIL=admin@example.com  
  
# General settings  
TEMPLATE_PATH=/app/data/template.png  
FIELDS_CONFIG_PATH=/app/fields_config.json  
FONTS_DIR=/app/fonts  
LOG_LEVEL=INFO  
  
# CORS Origins (comma-separated)  
CORS_ORIGINS=https://jabanes.github.io  
  
# Frontend URL (for reference only, frontend is hosted separately on GitHub Pages)  
FRONTEND_URL=https://jabanes.github.io 
